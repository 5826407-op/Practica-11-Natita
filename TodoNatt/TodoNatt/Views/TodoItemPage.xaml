<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TodoNatt.Views.TodoItemPage"
             Title="Detalle de Tarea">

    <StackLayout Padding="20" Spacing="15">
        <Label Text="Nombre de la tarea" />
        <Entry Text="{Binding Name}" Placeholder="Escribe la tarea..." />

        <Label Text="Notas adicionales" />
        <Entry Text="{Binding Notes}" Placeholder="Escribe notas..." />

        <StackLayout Orientation="Horizontal" Spacing="10">
            <CheckBox IsChecked="{Binding Done}" />
            <Label Text="¿Completada?" VerticalOptions="Center" />
        </StackLayout>

        <Button Text="Guardar" Clicked="OnSaveClicked" BackgroundColor="#512BD4" TextColor="White" />
        <Button Text="Eliminar" Clicked="OnDeleteClicked" BackgroundColor="Red" TextColor="White" />
        <Button Text="Cancelar" Clicked="OnCancelClicked" />
    </StackLayout>
</ContentPage>